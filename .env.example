# Local demo works without external services. Never use real customer data in demo mode.
ROLLOS_DEMO=true
# Optional local storage override; defaults to the ignored .rollos directory.
ROLLOS_DATA_DIR=
# Deployed canonical origin (no trailing slash). Required for provider callbacks.
APP_URL=

# Hosted mode activates only when all three Supabase values are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Configuration (sk_test_... for test mode, sk_live_... for live payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate your own random value with at least 32 characters for hosted driver links.
DRIVER_TOKEN_SECRET=

# SMS and delivery-status callbacks (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Transactional email delivery through Resend (optional in demo, recommended for production).
# RESEND_API_KEY: API key from https://resend.com
RESEND_API_KEY=
# EMAIL_FROM: Verified sender email address (e.g. orders@yourdomain.com)
EMAIL_FROM=

# Admin alert notifications (optional): receive instant email & SMS alerts when orders or add-ons are purchased.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# Scheduled maintenance & daily reminders cron secret.
# CRON_SECRET: Bearer token used to authenticate calls to /api/reminders.
CRON_SECRET=
