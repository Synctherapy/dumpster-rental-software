# Local demo works without external services. Never use real customer data in demo mode.
ROLLOS_DEMO=true
# Optional local storage override; defaults to the ignored .rollos directory.
ROLLOS_DATA_DIR=
# Deployed canonical origin (no trailing slash). Required for provider callbacks.
APP_URL=

# Hosted mode activates only when all three Supabase values are present.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Test mode only: live Stripe keys are deliberately rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate your own random value with at least 32 characters for hosted driver links.
DRIVER_TOKEN_SECRET=

# SMS and delivery-status callbacks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional email delivery through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Protects the scheduled reminders endpoint in hosted mode.
CRON_SECRET=
